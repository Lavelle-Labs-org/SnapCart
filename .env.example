# ==============================================================================
# Order-by-SMS Master Environment Configuration Reference
# ==============================================================================
# Copy this file or .env.development.example to .env for local development:
#   cp .env.development.example .env
#
# IMPORTANT SECURITY RULES:
# 1. NEVER commit any live secrets or credentials to git.
# 2. Only .env.example, .env.development.example, and .env.production.example are allowed in git.
# 3. In production, SESSION_SECRET and PICKUP_CODE_SECRET must be at least 32 characters
#    and cannot contain placeholder keywords ("replace_with", "example", "changeme", etc.).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Environment
# ------------------------------------------------------------------------------
# Runtime environment: "development" | "production" | "test"
NODE_ENV="development"

# NestJS Backend API port (default: 4000)
PORT=4000

# ------------------------------------------------------------------------------
# 2. Database Connections (PostgreSQL / Prisma)
# ------------------------------------------------------------------------------
# Connection string for Prisma Client query execution.
# - Local Docker (default port 5433): postgresql://postgres:postgres@localhost:5433/order_by_sms?schema=public
# - Local Native Postgres (port 5432): postgresql://postgres:postgres@localhost:5432/order_by_sms?schema=public
# - Production Supabase Transaction Pooler (port 6543): postgresql://postgres.[ref]:[pwd]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/order_by_sms?schema=public"

# Direct connection string for Prisma CLI schema migrations.
# - In local development: Identical to DATABASE_URL.
# - In Supabase Production: Direct port 5432 (bypasses transaction pooler for DDL migrations).
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/order_by_sms?schema=public"

# Docker Host Port mapping for PostgreSQL container in docker-compose.yml (default: 5433 to avoid Windows 5432 conflicts)
DB_PORT=5433

# ------------------------------------------------------------------------------
# 3. Frontend & Cross-Origin Resource Sharing (CORS)
# ------------------------------------------------------------------------------
# Public storefront and seller dashboard base URL (used to generate customer links in SMS)
# - Development: http://localhost:3000
# - Production:  https://ord.et
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Allowed CORS origin for NestJS API (apps/api)
# - Development: http://localhost:3000
# - Production:  https://ord.et
FRONTEND_URL="http://localhost:3000"

# Internal NestJS API URL consumed by Next.js Server Components and API rewrites
# - Development: http://localhost:4000
# - Docker / Kubernetes Internal: http://api:4000
# - Production (if hosted separately): https://api.ord.et
INTERNAL_API_URL="http://localhost:4000"

# ------------------------------------------------------------------------------
# 4. Cryptographic Security Secrets
# ------------------------------------------------------------------------------
# High-entropy secret for signing seller JWT authentication session cookies.
# Minimum 32 characters. Generate with: openssl rand -hex 32
SESSION_SECRET="replace_with_at_least_32_random_characters_for_sessions"

# High-entropy secret for HMAC-SHA256 hashing of customer 4-digit pickup codes.
# Minimum 32 characters. Generate with: openssl rand -hex 32
PICKUP_CODE_SECRET="replace_with_at_least_32_random_characters_for_pickup_hash"

# ------------------------------------------------------------------------------
# 5. SMSHub Integration (Ethio telecom Gateway)
# ------------------------------------------------------------------------------
# SMSHub Execution Mode:
# - "test": Calls SMSHub /api/test (0 credits consumed, mock carrier responses). Recommended for dev & CI.
# - "live": Calls SMSHub /api/sms (real Ethio telecom SMS sent, consumes credits).
SMSHUB_MODE="test"

# SMSHub API Key:
# - Development/Test: Any string in "test" mode (e.g., sk_test_mock_order_by_sms_key)
# - Production: Live secret key from SMSHub portal (sk_live_...)
SMSHUB_API_KEY="sk_live_replace_with_your_smshub_secret_key"

# SMSHub Webhook Signing Secret:
# Secret key used to verify incoming HMAC-SHA256 signatures on /webhooks/smshub
SMSHUB_WEBHOOK_SECRET="whsec_replace_with_your_webhook_signing_secret"

# Optional: Custom SMSHub endpoint override (defaults to https://api.smshub.et)
# SMSHUB_BASE_URL="https://api.smshub.et"

# ------------------------------------------------------------------------------
# 6. Abuse Prevention, Rate Limiting & Guardrails
# ------------------------------------------------------------------------------
# Comma-separated list of Ethiopian phone numbers allowed for outbound SMS in test/demo mode.
# If unset or empty, sending is permitted to all valid Ethiopian numbers (+2519... or +2517...).
# Format: Local 10-digit ("0911223344,0711223344") or international ("+251911223344")
SMS_ALLOWLIST="0911223344,0711223344"

# Daily outbound SMS dispatch limit across the system (default: 50)
SMS_DAILY_CAP=50

# Emergency Kill-Switch: Set to "true" to immediately pause all outbound SMS dispatches
SMS_SENDING_PAUSED="false"

# Optional UI Indicator: Set to "true" to display low SMS credit warning banner in seller dashboard
SMS_BALANCE_LOW="false"
