# SMSHub Credentials (never commit live keys)
SMSHUB_API_KEY="sk_live_replace_with_your_smshub_secret_key"
SMSHUB_WEBHOOK_SECRET="whsec_replace_with_your_webhook_signing_secret"
# Mode: "test" (calls /api/test, 0 credits) or "live" (calls /api/sms)
SMSHUB_MODE="test"

# Secrets for Security & Cryptography
SESSION_SECRET="replace_with_at_least_32_random_characters_for_sessions"
PICKUP_CODE_SECRET="replace_with_at_least_32_random_characters_for_pickup_hash"

# Database Connection (PostgreSQL)
# When using Supabase: DATABASE_URL uses port 6543 (pooler), DIRECT_URL uses port 5432 (migrations)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/order_by_sms?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/order_by_sms?schema=public"

# App Public URL (used for generating links in SMS)
NEXT_PUBLIC_APP_URL="https://ord.et"

# Abuse & Guardrail Settings (optional)
# Comma-separated normalized phone numbers allowed for live SMS in demo mode
SMS_ALLOWLIST="0911223344,0711223344"
SMS_DAILY_CAP=50
SMS_SENDING_PAUSED="false"
