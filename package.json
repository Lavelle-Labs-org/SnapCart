{
  "name": "order-by-sms",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm --workspace=@order-by-sms/web run dev",
    "dev:api": "npm --workspace=@order-by-sms/api run dev",
    "build": "npm run build:contracts && npm run build:web && npm run build:api",
    "build:contracts": "npm --workspace=@order-by-sms/contracts run build",
    "build:web": "npm --workspace=@order-by-sms/web run build",
    "build:api": "npm run build:contracts && npm --workspace=@order-by-sms/api run build",
    "start": "npm --workspace=@order-by-sms/web run start",
    "lint": "npm --workspace=@order-by-sms/web run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "template:check": "tsx scripts/check-templates.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "ci:check": "npx tsc --noEmit && npm test && npm run build"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
