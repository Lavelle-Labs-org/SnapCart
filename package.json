{
  "name": "order-by-sms",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm --workspace=@order-by-sms/web run dev",
    "dev:api": "npm --workspace=@order-by-sms/api run dev",
    "build": "npm run build:contracts && npm run build:web && npm run build:api && node scripts/prepare-vercel.js",
    "build:contracts": "npm --workspace=@order-by-sms/contracts run build",
    "build:web": "npm --workspace=@order-by-sms/web run build && node scripts/prepare-vercel.js",
    "build:api": "npm run build:contracts && npm --workspace=@order-by-sms/api run build",
    "start": "npm --workspace=@order-by-sms/web run start",
    "lint": "npm --workspace=@order-by-sms/web run lint && npm --workspace=@order-by-sms/api run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "node --env-file-if-exists=.env.development --env-file-if-exists=.env ./node_modules/prisma/build/index.js generate",
    "prisma:push": "node --env-file-if-exists=.env.development --env-file-if-exists=.env ./node_modules/prisma/build/index.js db push",
    "prisma:migrate": "node --env-file-if-exists=.env.development --env-file-if-exists=.env ./node_modules/prisma/build/index.js migrate dev",
    "prisma:migrate:deploy": "node --env-file-if-exists=.env.development --env-file-if-exists=.env ./node_modules/prisma/build/index.js migrate deploy",
    "prisma:migrate:status": "node --env-file-if-exists=.env.development --env-file-if-exists=.env ./node_modules/prisma/build/index.js migrate status",
    "prisma:seed": "node --env-file-if-exists=.env.development --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "prisma:studio": "node --env-file-if-exists=.env.development --env-file-if-exists=.env ./node_modules/prisma/build/index.js studio",
    "template:check": "tsx scripts/check-templates.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "ci:check": "npx tsc --noEmit && npm test && npm run build"
  },
  "overrides": {
    "tinypool": "2.2.0",
    "multer": "^2.5.0",
    "postcss": "^8.5.31",
    "qs": "6.16.1",
    "file-type": "21.3.4",
    "postcss-selector-parser": "7.1.7",
    "vite": "6.4.5"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.9",
    "clsx": "^2.1.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "multer": "^2.5.0",
    "postcss": "^8.5.31",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
